# Frontend (Next.js) — copy to packages/frontend/.env.local

# This site's origin (used for metadata/OG URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin of the backend API WITHOUT a trailing /api, e.g. https://api.example.com
# Leave unset in local dev: requests stay relative and go through the
# next.config.ts rewrite to API_PROXY_URL.
# NEXT_PUBLIC_API_URL=

# Server-side rewrite target for /api/* (local dev default: http://localhost:4000)
# API_PROXY_URL=http://localhost:4000
